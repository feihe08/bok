{
  "name": "wxt-react-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.15",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p \"$HOME/Library/Application Support/bok-test-chrome\" && wxt",
    "verify": "wxt prepare && pnpm compile && wxt build",
    "worktree": "node scripts/worktree.mjs",
    "check:worktree": "node scripts/check-worktree.mjs",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm compile && BOK_RELEASE_BUILD=1 wxt zip && node scripts/sync-release.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip": "pnpm build",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "check:reading-list": "jiti scripts/check-reading-list.mjs",
    "check:reading-list-background": "jiti scripts/check-reading-list-background.mjs",
    "check:session-import": "jiti scripts/check-session-import.mjs",
    "check:session-operations": "jiti scripts/check-session-operations.mjs",
    "check:bookmark-backup": "jiti scripts/check-bookmark-backup.mjs",
    "check:bookmark-organization-ai-settings": "jiti scripts/check-bookmark-organization-ai-settings.mjs",
    "check:bookmark-organization-ai-messages": "jiti scripts/check-bookmark-organization-ai-messages.mjs",
    "check:bookmark-codex-bridge": "jiti scripts/check-bookmark-codex-bridge.mjs",
    "check:bookmark-native-host": "node scripts/check-bookmark-native-host.mjs",
    "check:bookmark-default-folder": "jiti scripts/check-bookmark-default-folder.mjs",
    "check:bookmark-delete": "jiti scripts/check-bookmark-delete.mjs",
    "check:bookmark-organizer-background": "jiti scripts/check-bookmark-organizer-background.mjs",
    "check:bookmark-organizer": "jiti scripts/check-bookmark-organizer.mjs",
    "check:bookmark-organizer-operations": "jiti scripts/check-bookmark-organizer-operations.mjs",
    "check:bookmark-organizer-responses": "jiti scripts/check-bookmark-organizer-responses.mjs",
    "bookmarks:codex": "node scripts/bok-bookmarks-cli.mjs",
    "bookmarks:install-bridge": "node scripts/install-bookmark-native-host.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "wxt": "^0.20.15"
  }
}
